{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jdawg867/anvildesk/rootfs/manifests/schema-v1.json",
  "title": "AnvilDesk rootfs manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "distribution",
    "version",
    "architecture",
    "url",
    "sha256",
    "sourceUrl"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "distribution": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "architecture": { "const": "aarch64" },
    "url": { "type": "string", "pattern": "^https://" },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "sizeBytes": { "type": "integer", "minimum": 1 },
    "sourceUrl": { "type": "string", "pattern": "^https://" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "url"],
      "properties": {
        "scheme": { "enum": ["gpg", "minisign"] },
        "url": { "type": "string", "pattern": "^https://" },
        "keyFingerprint": { "type": "string", "minLength": 8 }
      }
    }
  }
}
